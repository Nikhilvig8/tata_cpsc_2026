<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- VAPT finding "Information Disclosure": directory listing exposes every file name
             (including backup/legacy controller copies, logs, etc.) to anyone who requests a
             folder URL with no default document. -->
        <directoryBrowse enabled="false" />
    </system.webServer>
</configuration>
