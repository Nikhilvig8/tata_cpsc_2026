<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to secrets.config (which is git-ignored) and fill in real values. -->
<appSettings>
  <add key="SmtpHost" value="smtp.example.local" />
  <add key="SmtpPort" value="25" />
  <add key="SmtpUser" value="REPLACE_ME" />
  <add key="SmtpPassword" value="REPLACE_ME" />
  <add key="TableauClientId" value="REPLACE_ME" />
  <add key="TableauSecretId" value="REPLACE_ME" />
  <add key="TableauSecretValue" value="REPLACE_ME" />
  <add key="SendGridApiKey" value="REPLACE_ME" />
  <!-- Optional special logins (leave commented out to disable; never use a placeholder value). -->
  <!-- <add key="SpecialLoginUser" value="REPLACE_ME" /> -->
  <!-- <add key="SpecialLoginPassword" value="REPLACE_ME" /> -->
  <!-- <add key="MasterLoginPassword" value="REPLACE_ME" /> -->
</appSettings>
