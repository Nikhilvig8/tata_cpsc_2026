            border: 0px solid #000;
            height: 15%;
            flex: 0 0 auto;
        }

        .right-bottom {
            border: 0px solid #000;
            height: 85%;
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            overflow-y: auto;
            box-sizing: border-box;
        }

        .right-bottom img.img-responsive {
            max-height: 16vh;
            width: auto;
            max-width: 60%;
        }

        .form-group-css {
            width: 80%;
        }

        .username {
            border-radius: 0px;
            background: #da1f26;
            border: 1px solid #FFFFFF;
            height: 45px;
            color: white;
        }

        .pass {
