<body>
  
    <div class="content login-content">
        <div class="col-md-7 left-side">
            &nbsp;
        </div>
        <div class="col-md-5 right-side" style="background: #3f5caa;">
            <div class="logo" style="margin-left:-15px;margin-right:-15px;padding:6px; background:#fff; color:red; font-size:15px;">
                <marquee>CPSC System has been Open for May Actual and June Target data entry.</marquee>
                @*<marquee>We’re currently experiencing technical difficulties with the CPSC System. Our CRM Team is actively working to resolve the issue.</marquee>*@
            </div>
            <div class="col-md-12 right-top" style="height:9%">&nbsp;</div>
            <div class="col-md-12 right-bottom">
                <div class="row" align="center" style="margin-top:1.5vh;"><img src="~/assets/Updated_Images/Tata_logo.png" class="img-responsive" title="Tata" style="width:60%;" /></div>
                <div class="row" align="center">
                    <h3 style="color:#FFFFFF; margin: 1vh 0;">LOGIN</h3>

                  @using (Html.BeginForm("LoginCheck", "Login", FormMethod.Post))
                  {
                        @Html.AntiForgeryToken()
                        <div class="form-group form-group-css">
                            <input class="form-control form-control-solid placeholder-no-fix username" type="text" autocomplete="off" placeholder="Enter Username" name="username" style="background:#3f5caa" />
                        </div>
                        <div class="form-group form-group-css">
                            <input class="form-control form-control-solid placeholder-no-fix pass" id="pass" type="password" autocomplete="off" placeholder="Enter Password" name="password" style="background:#3f5caa" />
                        </div>
                        @* Honeypot: off-screen (not display:none - some bots skip fields hidden
                           that way), out of tab order, no autofill hint. A real user never sees or
                           fills this; a bot that fills every field on the form will. See
                           LoginController.LoginCheck for the matching server-side check. *@
                        <div style="position:absolute; left:-9999px; top:-9999px; height:0; width:0; overflow:hidden;" aria-hidden="true">
                            <input type="text" name="website" tabindex="-1" autocomplete="off" value="" />
                        </div>
                        @* Self-hosted alphanumeric CAPTCHA: application-level only, no external
                           service, no keys, no database. The <img> below triggers its own request
                           to CaptchaImage(), which generates the code and draws it distorted - see
                           LoginController.CaptchaImage / VerifySelfHostedCaptcha. *@
                        <div class="form-group form-group-css">
                            <img src="@Url.Action("CaptchaImage", "Login")" alt="Security code" style="background:#fff; border:1px solid #fff; display:block; margin-bottom:6px;" />
                            <input class="form-control form-control-solid placeholder-no-fix" type="text" autocomplete="off" placeholder="Enter the code shown above" name="captchaAnswer" style="background:#3f5caa; color:#fff;" />
                        </div>
                        <div class="form-group form-group-css">

                            @{
                                if (Session["Popup"] != null)
                                {
                                    if (Session["Popup"].ToString() == "0")
                                    {
                                        <p style="color:white;"> Incorrect Username and Password. </p>
                                    }
                                    else if (Session["Popup"].ToString() == "2")
                                    {
                                        <p style="color:white;"> you are not authorized user.Please contact to CPSC support team.</p>
                                    }
                                    else if (Session["Popup"].ToString() == "4")
                                    {
                                        <p style="color:white;"> Too many failed attempts. Please try again in a few minutes.</p>
                                    }
                                    else if (Session["Popup"].ToString() == "5")
                                    {
                                        <p style="color:white;"> Please complete the CAPTCHA check and try again.</p>
                                    }
                                    else if (Session["Popup"].ToString() == "6")
                                    {
                                        <p style="color:white;"> You were signed out because your account was logged in elsewhere.</p>
                                    }
                                }
                                Session["Popup"] = string.Empty;
                            }
                            </div>

                            <div class="form-group form-group-css" style="text-align:right;">
                                @*<a href="@Url.Action("ForgetPassword","Login")" id="forget-password" class="forget-password"  style="color:#fff;">Forgot Password</a>*@
                                &nbsp;
                            </div>


                            <div class="form-group form-group-css">
                                <button type="submit" class="btn btn-block green uppercase login-button" id="Login"style="background: #ffffff;border-color: #ffffff;color: #3f5caa;">SIGN IN</button>
                            </div>
                            }
                        @* SSO button hidden for now - Keycloak's TOTP enrollment step is throwing an
                           internal server error on Tata's side, so the SSO login flow can't
                           actually complete yet. SsoLogin/OidcCallback are untouched - just
                           uncomment this to bring the button back once Central Auth resolves it. *@
                        @*
                        <div class="form-group form-group-css" style="text-align:center; margin-top:10px;">
                            <a href="@Url.Action("SsoLogin","Login")" class="btn btn-block uppercase" style="background:#3f5caa;border-color:#ffffff;color:#ffffff;">Sign in with Company SSO</a>
                        </div>
                        *@
                        </div>
            </div>
        </div>
    </div>
    <a id="msg_click" name="msg_click" class="btn btn-link" style="line-height:0;margin-top:-4px; display:none;" href="#user_msg" data-toggle="modal"><i class="fa fa-edit" style="color:orange;"></i></a>
