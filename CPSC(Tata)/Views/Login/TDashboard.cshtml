    <style>
        /* Style for the chat button */
        #chatButton {
            position: fixed;
            bottom: 20px;
            right: 20px;
            /*padding: 10px 20px;*/
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            z-index: 9999; /* Ensure the button stays on top of other elements */
            width: 70px; /* Adjust the width as needed */
            height: 70px; /* Adjust the height as needed */
        }

            #chatButton:hover {
                background-color: #0056b3;
            }

        /* Style for the chat box modal */
        .modal1 {
            display: none;
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 99999; /* Ensure the modal stays on top of other elements */
        }

        .modal1-content {
            background-color: #f0f0f0;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

            .close:hover,
            .close:focus {
                color: black;
                text-decoration: none;
                cursor: pointer;
            }

        /* Style for chat content */
        .chat-content {
            overflow-y: auto; /* Enable scrolling if content exceeds container height */
            max-height: 300px; /* Set a maximum height to limit the chat box size */
        }

        .message {
            margin-bottom: 10px;
        }

        .computer-message {
            background-color: #7d7d7d2e;
            padding: 10px;
            border-radius: 10px 10px 10px 0;
            clear: both;
            float: left;
        }

        .user-message {
            background-color: #3598dc;
            color: #fff;
            padding: 10px;
            border-radius: 10px 10px 0 10px;
            clear: both;
            float: right;
        }

        .symbol {
            display: inline-block;
            width: 30px; /* Adjust the width as needed */
            text-align: center;
        }

        .computer-message .symbol {
            float: left;
            margin-right: 5px; /* Adjust the spacing as needed */
        }

        .user-message .symbol {
            float: right;
            margin-left: 5px; /* Adjust the spacing as needed */
        }
    </style>
    <script>
    // JavaScript to handle the chat button functionality
    document.getElementById("chatButton").addEventListener("click", function () {
        // Display the chat box modal
        document.getElementById("chatModal").style.display = "block";
    });

    // Close the chat box modal when the close button is clicked
    document.querySelector(".close").addEventListener("click", function () {
        document.getElementById("chatModal").style.display = "none";
    });

    // Handle user options
    document.getElementById("options").addEventListener("click", function (event) {
        const option = event.target.id;
        const chatContent = document.getElementById("chatContent");

        switch (option) {
            case "ConcurrentDashboard":
                // Handle score issue
                appendMessage("user", "Dashboard not visible?");
                appendMessage("computer", "Kindly write an email to cpsc@tatamotors.com with error screenshot mentioning with Login Id.");
                //appendMessage("computer", "Below is the reason.concuurent");
                break;
            case "IncorrectTarget":
                // Handle dashboard issue
                appendMessage("user", "Incorrect Target/Actual captured?");
                appendMessage("computer", "Kindly connect with your regional team to get the value corrected.");
                break;
            //case "IncorrectFigure":
            //    // Handle issue related to both
            //    appendMessage("user", "Incorrect actual figures");
            //    appendMessage("computer", "Understood, Actual figures.");
            //    break;
            case "Clarification":
                // Handle issue related to both
                appendMessage("user", "Clarification on parameter calculation process");
                appendMessage("computer", "Kindly refer to CPSC handbook and for more clarification connect with regional team.");
                break;
            case "ProductLine":
                // Handle issue related to both
                appendMessage("user", "On which date scorecard will be generate");
                appendMessage("computer", "Every month on the eighth, the Monthly Scorecard will be released; the Concurrent Scorecard will follow afterwards.");
                break;
            default:
            // Do nothing
        }
    });

    // Function to append a message to the chat box
    //function appendMessage(sender, message) {
    //    const chatContent = document.getElementById("chatContent");
    //    const messageElement = document.createElement("div");
    //    messageElement.classList.add("message");

    //    if (sender === "computer") {
    //        messageElement.classList.add("computer-message");
    //    } else {
    //        messageElement.classList.add("user-message");
    //    }

    //    messageElement.textContent = message;
    //    chatContent.appendChild(messageElement);
    //}
    // Function to append a message to the chat box
    function appendMessage(sender, message) {
        const chatContent = document.getElementById("chatContent");
        const messageElement = document.createElement("div");
        messageElement.classList.add("message");

        if (sender === "computer") {
            messageElement.classList.add("computer-message");
            messageElement.innerHTML = `<span class="symbol">🤖</span> ${message}`;
        } else {
            messageElement.classList.add("user-message");
            messageElement.innerHTML = `<span class="symbol">👤</span> ${message}`;
        }

        chatContent.appendChild(messageElement);
    }

    </script>

