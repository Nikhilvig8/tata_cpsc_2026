<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-migrate-3.5.2.js"></script>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.3/jquery.min.js"></script>
<script type="text/javascript" src="//ajax.aspnetcdn.com/ajax/jQuery/jquery-1.7.1.min.js"></script>
<script type="text/javascript" src="//ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.0/jquery.dataTables.min.js"></script>


<script>
    $(document).ready(function () {
        $('.DataEntryDetail').dataTable({
            aLengthMenu: [
                [-1],
                ["All"]
            ],
            iDisplayLength: -1, searching: false, paging: false, info: false, "bSort": false
        });
    });
    $('#Data_Entry').on("click", ".ExcelUpload", function (e) {


        e.preventDefault();



        var fileExtension = ['xlsx'];
        var excelfile = $(this).closest("tr").find('.ExcelFile');
        var LastUpdateOn = $(this).closest("tr").find('.LastUpdateOn');
        var filename = $(this).closest("tr").find('.FileName').attr("filename");





        if (excelfile.val().length == 0) {

            alert("Please select a file.");

            return false;

        }

        else {

            var extension = excelfile.val().replace(/^.*\./, '');

            if ($.inArray(extension, fileExtension) == -1) {

                alert("Please select only excel files.");

                return false;

            }

        }





        var fdata = new FormData();

        var fileUpload = excelfile.get(0);

        var files = fileUpload.files;

        fdata.append(files[0].name, files[0]);
        fdata.append("file", files[0]);
        fdata.append("filename", filename);

        $.ajax({

            type: "POST",

            url: "/BulkExcelUpload/Importexcel",



            data: new { enctype: "multipart/form-data" },
            processData: false,
            contentType: false,
            success: function (response) {

                if (response.length == 0) {
                    alert('Some error occured while uploading');
                    excelfile.val(null);
                }
                else {
                    alert(response);

                    excelfile.val(null);

                    var currentdate = new Date();
                    var datetime = currentdate.getDate() + "-"
                        + (currentdate.getMonth() + 1) + "-"
                        + currentdate.getFullYear() + " "
                        + currentdate.getHours() + ":"
                        + currentdate.getMinutes() + ":"
                        + currentdate.getSeconds();
                    LastUpdateOn.text(datetime);




                }

            },

            error: function (e) {
                alert(e);
                excelfile.val(null);

            }

        });


    });
</script>
























