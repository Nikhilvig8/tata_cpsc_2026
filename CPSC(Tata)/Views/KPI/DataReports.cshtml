
@model InputOutput.Models.TransactionViewModel
@{
    ViewBag.Title = "DataReports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    string T_date = Session["Target_Date"].ToString();
    string A_date = Session["Actual_Date"].ToString();
    string target_month = DateTime.Parse(T_date).ToString("MMM");
    string Actual_month = DateTime.Parse(A_date).ToString("MMM");
    string target_year = DateTime.Parse(T_date).ToString("yy");
    //string Actual_year = DateTime.Parse(A_date).ToString("yy");
}

<div class="row">
    <div class="col-md-12">

        <div class="portlet light bordered" id="form_wizard_1">
            <div class="portlet-title" style="min-height:30px; margin-bottom:0px;">
                <div class="caption" style="padding:0px 0;">
                    <i class="icon-layers font-blue"></i>
                    <span class="caption-subject font-blue bold uppercase">
                        Input Pending - Target
                    </span>
                    
                </div>


                <div class="btn-group pull-right" style="margin-top: -8px;">
                    <button class="btn green btn-outline dropdown-toggle" data-toggle="dropdown">
                        Tools
                        <i class="fa fa-angle-down"></i>
                    </button>
                    <ul class="dropdown-menu pull-right">
                        <li>
                            <a id="Print"> Print </a>
                        </li>
                        <li>
                            <a id="ExcelExport"> Export to Excel </a>
                        </li>
                        @*<li>
                    <a id="Exporttopdf"> Export to Pdf </a>
                </li>*@
                    </ul>
                </div>

            </div>
            <div class="portlet-body form" style="overflow:auto; max-height:425px;">         
                    <div class="form-horizontal">
                        <div class="form-wizard" style="width:99%;">
                            <div class="form-body" style="padding:5px;">

                                <div class="tab-pane active" id="tab1">
                                    <!--h3 class="block">Provide your account details</h3-->



									<table id="example" class="table table-striped table-bordered display" cellspacing="0" width="100%">
										<thead>
											<tr>
												<th style="font-size:11px;">Dealer</th>
												<th style="font-size:11px;">Division</th>
												<th style="font-size:11px;">LOB</th>
												<th style="font-size:11px;">Parameter</th>
												<th style="font-size:11px;">Last Month Target</th>
												<th style="font-size:11px;">Last Month Actual</th>
												<th style="font-size:11px;">Target (@target_month'@target_year)</th>
												<th style="font-size:11px;">Actual (@target_month'@target_year)</th>
											</tr>
										</thead>
										<tbody>
									
                                    
                                    @using System.Data;
                                    @using System.Data.SqlClient;
                                    @using System.Globalization;
                                    @using System.Web;
                                    @using DataUtilityLayer;
                                    @using System.Configuration;
                                    @{
                                        SqlCommand cmdObj = new SqlCommand();
                                        string uid2 = Session["Uid"].ToString();
                                        string sheet = "Target";
                                        string CS1 = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;
                                        DataTable dtf2;
                                        string _sql2 = string.Empty;
                                        _sql2 = @"getPendingInputData";
                                        using (SqlConnection cn = new SqlConnection(CS1))
                                        {
                                            DataTable dt = new DataTable();
                                            //var cmd = new SqlCommand(_sql, cn);
                                            var daCampus = new SqlDataAdapter(_sql2, cn);
                                            daCampus.SelectCommand.CommandType = CommandType.StoredProcedure;
                                            daCampus.SelectCommand.Parameters.AddWithValue("@FW", Session["Uid"].ToString());
                                            daCampus.SelectCommand.Parameters.AddWithValue("@ForActual_Target", sheet);
                                            daCampus.Fill(dt);
                                            dtf2 = dt;
                                        }

                                    }


                                    @{if (dtf2.Rows.Count > 0)
                                        {
                                            for (int i = 0; i < dtf2.Rows.Count; i++)
                                            {
											<tr>
												<td style="font-size:11px;">@dtf2.Rows[i]["Dealer_Name"].ToString() - @dtf2.Rows[i]["City"].ToString()</td>
												<td style="font-size:11px;">@dtf2.Rows[i]["Division_Id"].ToString()</td>
												<td style="font-size:11px;">@dtf2.Rows[i]["LOB"].ToString()</td>
												<td style="font-size:11px;">@dtf2.Rows[i]["KPI_NAME"].ToString()</td>
                                        
                                            
                                                @{
                                                    string value_act = ""; string hide_act = "";
                                                    if (dtf2.Rows[i]["Actual_Value"].ToString() == "") { value_act = "NULL"; } else if (dtf2.Rows[i]["Actual_Value"].ToString() == "hidden") { hide_act = "display:none;"; } else { value_act = dtf2.Rows[i]["Actual_Value"].ToString(); }
                                                    string value_tar = ""; string hide_tar = "";
                                                    if (dtf2.Rows[i]["Target_Value"].ToString() == "") { value_tar = "NULL"; } else if (dtf2.Rows[i]["Target_Value"].ToString() == "hidden") { hide_tar = "display:none;"; } else { value_tar = dtf2.Rows[i]["Target_Value"].ToString(); }
                                                    string value_tar_T = ""; string hide_act_T = "";
                                                    if (dtf2.Rows[i]["Last_M_T"].ToString() == "") { value_tar_T = "NULL"; } else if (dtf2.Rows[i]["Last_M_T"].ToString() == "hidden") { hide_act_T = "display:none;"; } else { value_tar_T = dtf2.Rows[i]["Last_M_T"].ToString(); }
                                                    string value_tar_A = ""; string hide_act_A = "";
                                                    if (dtf2.Rows[i]["Last_M_A"].ToString() == "") { value_tar_A = "NULL"; } else if (dtf2.Rows[i]["Last_M_A"].ToString() == "hidden") { hide_act_A = "display:none;"; } else { value_tar_A = dtf2.Rows[i]["Last_M_A"].ToString(); }
                                                }
                                            <script src="~/Scripts/jquery-3.7.1.min.js"></script>
                                            <script src="~/Scripts/jquery-migrate-3.5.2.min.js"></script>
                                            <script>
                                                $(document).ready(function () {
                                                    var row_no1 = '@(i)';
                                                    var lastRowNo1 = row_no1;

                                                    var target_main1 = parseInt($("#Actual_main" + lastRowNo1).val());
                                                    var target_main12 = parseInt($("#Target" + lastRowNo1).val());

                                                    if (isNaN(target_main12))
                                                    { $("#Target" + lastRowNo1).css("border", "2px solid red"); }
                                                    else
                                                    {
                                                        if (isNaN(target_main1))
                                                        { $("#Actual_main" + lastRowNo1).css("border", "2px solid red"); }
                                                        else
                                                        {
                                                            
                                                        }
                                                        
                                                    }


                                                    
                                                });
                                            </script>

												<td style="font-size:10px;"><div style="font-size:9px;@hide_act_T" class="form-control" id="L_M_T@(i)" name="L_M_T" disabled="disabled">@value_tar_T</div></td>
												<td style="font-size:10px;"><div style="font-size:9px;@hide_act_A" class="form-control" id="L_M_A@(i)" name="L_M_A" disabled="disabled">@value_tar_A</div></td>
												<td style="font-size:10px;"><div style="font-size:9px;@hide_tar" class="form-control" id="Target@(i)" name="Target" disabled="disabled">@value_tar</div></td>
												<td style="font-size:10px;"><div style="font-size:9px;@hide_act" class="form-control" id="Actual_main@(i)" name="Actual" data-required="1" disabled="disabled">@value_act</div></td>
											</tr>
                                    <!-- row 1 end-->
                                    <!-- row 2 start-->
                                                }
                                            }
                                        }
                                            </tbody></table>
                        </div>



                            </div>
                        </div>
                        <!--col-md-offset-7 -->
                        
                        

                    </div>


                                        
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function () {



    $("#example").dataTable({


        "bPaginate": false


    });


});
</script>
