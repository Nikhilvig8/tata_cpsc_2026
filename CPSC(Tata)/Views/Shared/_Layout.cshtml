    @using System.Data;
    @using System.Data.SqlClient;
    @using System.Globalization;
    @using System.Web;
    @using System.Configuration;
    <!-- Pending Inputs -->
    @{
        string uidPI = Session["Uid"].ToString();

        DataTable dtfPI;
        string _sqlPI = string.Empty;
        string CS_lay = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;



        DateTime actual_date = Convert.ToDateTime(Session["Actual_date"].ToString());

        String month_curr_name = actual_date.AddMonths(0).ToString("MMM");/*DateTime.Now.ToString("MMM");*/
        String month_last_name = actual_date.AddMonths(0).ToString("MMM");

        int Month_curr = actual_date.Month;
        int Year_curr = actual_date.Year;

        using (SqlConnection cnPI = new SqlConnection(CS_lay))
        {
            SqlDataAdapter da = new SqlDataAdapter("getChartData_Actual", cnPI); // Using a Store Procedure.
                                                                                 //SqlDataAdapter da = new SqlDataAdapter("SELECT 'this is a test text' as test", con); To use a hard coded query.
            da.SelectCommand.CommandType = CommandType.StoredProcedure; // Comment if using hard coded query.
            da.SelectCommand.CommandTimeout = 3600;
            DataSet ds = new DataSet(); // Definition: Memory representation of the database.
            da.SelectCommand.Parameters.AddWithValue("@ForYear", Year_curr); // Repeat for each parameter present in the Store Procedure.
            da.SelectCommand.Parameters.AddWithValue("@ForMonth", Month_curr);
            da.SelectCommand.Parameters.AddWithValue("@Userid", uidPI);

            da.Fill(ds); // Fill the dataset with the query data
            dtfPI = ds.Tables[0];

        }
    }





    <script>
        var chart = AmCharts.makeChart("chart_1", {
            "type": "serial",
            "theme": "light",
            "rotate": false,
            "legend": {
                //"autoMargins": false,
                //"borderAlpha": 0.2,
                //"equalWidths": false,
                //"horizontalGap": 10,
                //"markerSize": 10,
                //"useGraphSettings": true,
                //"valueAlign": "left",
                "position": "right",
                "align": "left",
                "valueWidth": 0,
                "top": 30,
                "left": 100,
                "width": 130
            },
            "titles": [
            {
                "size": 15,
                "text": "Actual - Data Entry Status (@month_last_name)",
                "margin-top": 10
            }],

            "dataProvider": [{
                "year": "",
                "PendingInputs": "@dtfPI.Rows[0]["Pending_Item"].ToString()",
                "PendingApproval": "@dtfPI.Rows[0]["PendingApp"].ToString()"
            }, {
                "year": "",
                "DataOk": "@dtfPI.Rows[0]["DataOk"].ToString()",
                "SuspectData": "@dtfPI.Rows[0]["SuppectedData"].ToString()"
            }],
            "valueAxes": [{
                "stackType": "100%",
                "axisAlpha": 1,
                "axisColor": "#cccccc",
                "gridAlpha": 0,
                "labelsEnabled": true,
                "position": "left",
                "labelFrequency": 1,
                "showFirstLabel": true,
                "showLastLabel": true
            }],
            "graphs": [{
                "balloonText": "[[title]], [[category]]<br><span style='font-size:14px;'><b>[[value]]</b> ([[percents]]%)</span>",
                "fillAlphas": 0.9,
                "fontSize": 11,
                "labelText": "[[value]]",
                "lineAlpha": 0.5,
                "title": "Pending Inputs",
                "type": "column",
                "valueField": "PendingInputs"
            }, {
                "balloonText": "[[title]], [[category]]<br><span style='font-size:14px;'><b>[[value]]</b> ([[percents]]%)</span>",
                "fillAlphas": 0.9,
                "fontSize": 11,
                "labelText": "[[value]]",
                "lineAlpha": 0.5,
                "title": "Approval Pending",
                "type": "column",
                "valueField": "PendingApproval"
            }, {
                "balloonText": "[[title]], [[category]]<br><span style='font-size:14px;'><b>[[value]]</b> ([[percents]]%)</span>",
                "fillAlphas": 0.9,
                "fontSize": 11,
                "labelText": "[[value]]",
                "lineAlpha": 0.5,
                "title": "Data Ok",
                "type": "column",
                "valueField": "DataOk"
            }, {
                "balloonText": "[[title]], [[category]]<br><span style='font-size:14px;'><b>[[value]]</b> ([[percents]]%)</span>",
                "fillAlphas": 0.9,
                "fontSize": 11,
                "labelText": "[[value]]",
                "lineAlpha": 0.5,
                "title": "Suspect Data",
                "type": "column",
                "valueField": "SuspectData"
            }],
            "marginTop": 40,
            "marginRight": 0,
            "marginLeft": 0,
            "marginBottom": 10,
            "autoMargins": false,
            "categoryField": "year",
            "categoryAxis": {
                "gridPosition": "start",
                "axisAlpha": 1,
                "axisColor": "#cccccc",
                "axisBeta": 1,
                "gridAlpha": 0,
                "labelsEnabled": true,
                "labelFrequency": 1,
                "showFirstLabel": true,
                "showLastLabel": true
            },
            "export": {
                "enabled": false
            }
        });

        chart.addListener("clickGraphItem", handleClick)

        function handleClick(event) {
            //console.log(event);
            //alert(event.item.graph.title);
            if (event.item.graph.title == 'Pending Inputs') {
                window.location = "../KPI/DataReports_actual";
            }
            else if (event.item.graph.title == 'Approval Pending') {
                window.location = "../KPI/DataReportsPA_actual";
            }
            else if (event.item.graph.title == 'Data Ok') {
                window.location = "../KPI/DataReportsDO_actual";
            }
            else if (event.item.graph.title == 'Suspected Data') {
                window.location = "../KPI/DataReportsDS_actual";
            }

            //alert(event.item.category);
            //console.log(event);
        }


    </script>


